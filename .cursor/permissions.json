{
  // Commands the agent runs routinely in this repo. Allowlisted calls are
  // checked before Auto-review's classifier, so they no longer surface an
  // approval card. `git push` is the one that kept prompting: the classifier
  // flags it as mutating shared remote state, while .cursor/rules/
  // version-commit-push.mdc requires committing and pushing in the same turn.
  //
  // Matching is case-sensitive prefix: "git push" also matches "git push -u
  // origin HEAD", but nothing else under git. Note that defining this key
  // makes the in-app allowlist editor read-only for terminal commands.
  "terminalAllowlist": [
    "git status",
    "git diff",
    "git log",
    "git show",
    "git add",
    "git commit",
    "git push",
    "git checkout",
    "git stash",

    // Local build / Evaluate harness.
    "./gradlew",
    ".\\gradlew.bat",
    "gradlew.bat",

    // Device round-trip: install a build, pull Evaluate artifacts, read or
    // replace golden truth under the app's own data dir.
    "adb"
  ]
}
